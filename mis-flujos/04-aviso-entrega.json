    {
      "parameters": {
        "jsCode": "const fechaISO = $now.plus({ days: 1 }).toFormat('yyyy-MM-dd');\nconst fechaHumana = $now.plus({ days: 1 }).toFormat('dd/MM/yyyy');\nconst encargos = $input.all().map(i => i.json).filter(e => e.id && e.fecha_entrega === fechaISO);\n\nif (!encargos.length) return [];\n\nconst avisos = encargos.map(e => {\n  const pendiente = Number(e.pendiente);\n  const texto = e.estado === 'pagado'\n    ? `Hola ${e.cliente},\\n\\nMañana ${fechaHumana} puedes recoger tu ${e.tarta} (${e.raciones} raciones).\\n\\n¡Te esperamos!\\n\\nPastelería La Cuchara`\n    : `Hola ${e.cliente},\\n\\nMañana ${fechaHumana} es la entrega de tu ${e.tarta} (${e.raciones} raciones) y aún te faltan ${pendiente.toFixed(2)} €.\\n\\nPuedes pagar al recogerla.\\n\\nPastelería La Cuchara`;\n  return { json: { destinatario: e.email, asunto: `Tu encargo #${e.id}: entrega mañana`, texto } };\n});\n\nconst lineas = encargos.map(e => {\n  const estado = e.estado === 'pagado' ? 'pagado' : `pendiente: ${Number(e.pendiente).toFixed(2)} €`;\n  return `#${e.id} ${e.cliente} — ${e.tarta} (${estado})`;\n});\navisos.push({ json: {\n  destinatario: 'marisa@lacuchara.example',\n  asunto: `Entregas de mañana: ${encargos.length}`,\n  texto: `Hola Marisa,\\n\\nMañana ${fechaHumana} hay ${encargos.length} entrega(s):\\n\\n${lineas.join('\\n')}\\n\\nPastelería La Cuchara`,\n}});\nreturn avisos;"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        480,
        0
      ],
      "id": "25167777-4e84-46fb-b613-d69bdc3d5857",
